{
  "manifest_version": 3,
  "name": "CouponTest",
  "version": "0.1.0",
  "description": "Phase 1 coupon tester: paste coupon codes, test them on the current cart/checkout page, and rank the best working discount.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "CouponTest",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
